.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-top: 24rpx;
  padding-bottom: 32rpx;
}

.head { margin-bottom: 28rpx; }
.sub { margin-top: 4rpx; }

/* ---------- 顶部统计 ---------- */
.stat-row {
  display: flex;
  align-items: flex-end;
  gap: 40rpx;
  margin-bottom: 24rpx;
}
.stat .num {
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -1rpx;
  color: var(--text);
}
.stat .num.green { color: var(--ok); }
.tap-tip { text-align: right; line-height: 1.5; }

/* ---------- 地图 ---------- */
.map-wrap {
  position: relative;
  flex: 1;
  min-height: 400rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #EDF2F0;
}
.map {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.map-loading {
  position: absolute;
  left: 24rpx;
  top: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  font-size: 24rpx;
  color: var(--text-2);
  animation: fadeIn 300ms var(--ease) both;
}

.map-legend {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  display: flex;
  gap: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
}
.lg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-2);
}
.lg-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }

/* ---------- 图层切换 ---------- */
.layer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}
.chip {
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  background: #fff;
  color: var(--text-2);
  font-size: 26rpx;
  transition: background 200ms var(--ease), color 200ms var(--ease), transform 320ms var(--spring);
}
.chip.on {
  background: var(--brand);
  color: #fff;
}
.chip:active { transform: scale(0.95); }
.locate {
  font-size: 24rpx;
  color: var(--brand);
  padding: 12rpx 8rpx;
}

/* ---------- 点位提示卡 ---------- */
.tip-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: var(--brand-light);
  animation: fadeUp 420ms var(--spring) both;
}
.tip-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex-shrink: 0;
  animation: breathe 2s var(--ease) infinite;
}
.tip-title {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.5;
}
.tip-close {
  padding: 0 8rpx;
  color: var(--text-3);
  font-size: 32rpx;
  line-height: 1;
}

/* ---------- 底部 ---------- */
.footer {
  margin-top: auto;
  padding-top: 32rpx;
}
.foot-hint {
  text-align: center;
  margin-top: 18rpx;
}
