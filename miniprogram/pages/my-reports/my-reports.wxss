.page {
  padding: 24rpx 32rpx 60rpx;
}

/* ---------- 筛选 ---------- */
.tabs {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.tabs ::-webkit-scrollbar { display: none; }
.tab {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 14rpx;
  border-radius: 32rpx;
  background: #fff;
  color: var(--text-2);
  font-size: 26rpx;
  transition: all 200ms var(--ease);
}
.tab.on {
  background: var(--brand);
  color: #fff;
}

/* ---------- 列表 ---------- */
.list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.item {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  transition: transform 320ms var(--spring), background 160ms var(--ease);
}
.item:active {
  transform: scale(0.985);
  background: #FAFCFC;
}
.thumb {
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #F1F5F4;
  flex-shrink: 0;
}
.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.type {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}
.status { font-size: 24rpx; }
.addr {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.5;
}
.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.meta { margin-top: 10rpx; }

/* ---------- 空态 ---------- */
.empty-btn {
  width: 300rpx;
  margin: 36rpx auto 0;
}
